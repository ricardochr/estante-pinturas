<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad de Android 12+: inventario y proyectos, sin fotos de gavetas -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="inventario.json" />
        <include domain="file" path="catalogo-extra.json" />
        <include domain="file" path="projects.json" />
        <include domain="file" path="projects/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="inventario.json" />
        <include domain="file" path="catalogo-extra.json" />
        <include domain="file" path="projects.json" />
        <include domain="file" path="projects/" />
    </device-transfer>
</data-extraction-rules>
